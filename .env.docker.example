# Copiar a .env.docker y completar antes de levantar los servicios.
# No copiar encima del .env actual ni subir credenciales a Git.
# Los valores con caracteres especiales deben ir entre comillas simples.
# Mantener los valores numericos de ejemplo si no necesitas cambiarlos.

# Docker Compose.
APP_IMAGE=leadmanagerpuntoreactivo:production
# El puerto del VPS esta fijado en 8777 en compose.yaml.
WEB_CONCURRENCY=2

# Generar una contrasena para Redis distinta de DB_PASSWORD.
REDIS_PASSWORD=

# Variables de tu .env actual.
# Compose mantiene ENVIRONMENT=PRODUCTION dentro de los contenedores.
ENVIRONMENT=PRODUCTION

# Generar SECRET_KEY y las contrasenas: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Estas variables inicializan una base NUEVA cuando el volumen esta vacio.
# Cambiarlas despues no renombra la base ni cambia la contrasena almacenada.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Compose fija el host y puerto internos para conectar con su servicio postgres.
DB_HOST=postgres
DB_PORT=5432

# Dejar estas dos vacias: el entrypoint las genera usando REDIS_PASSWORD
# codificada para URL, el servicio redis y las bases 10 (broker) y 11 (resultados).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Se conserva por compatibilidad con tu .env; el codigo actual no la utiliza.
CELERY_RETRY_LIMIT=

OPENAI_API_KEY=
# Este valor si controla los reintentos de las llamadas a OpenAI.
OPENAI_MAX_RETRIES=2

CHAT_HISTORY_LIMIT=15

TAVILY_API_KEY=

IMAP_USER=
IMAP_PASS=
IMAP_HOST=
IMAP_PORT=993

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FROM_NAME='Sofia de Estrasol'

ODOO_URL=
ODOO_DB=
# Se conserva por compatibilidad; las llamadas a Odoo usan ODOO_UID y ODOO_API_KEY.
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_UID=
ODOO_TAG_ID=
ODOO_SELLER_ID=
ODOO_SELLER_NAME=
