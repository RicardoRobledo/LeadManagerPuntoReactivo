# Copiar a .env.docker y completar antes de levantar los servicios.
# No copiar encima del .env actual ni subir credenciales a Git.
# Los valores con caracteres especiales deben ir entre comillas simples.

APP_IMAGE=leadmanager:local
WEB_PORT=8000
WEB_CONCURRENCY=2

# Generar SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
OPENAI_API_KEY=

# Estas variables inicializan una base NUEVA cuando el volumen esta vacio.
# Cambiarlas despues no renombra la base ni cambia la contrasena almacenada.
POSTGRES_DB=leadmanager
POSTGRES_USER=leadmanager
# Generar dos contrasenas distintas con el mismo comando de secrets anterior.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Compose fija DB_HOST=postgres y DB_PORT=5432. El entrypoint construye las
# URLs de Celery con la contrasena de Redis codificada, incluyendo caracteres especiales.

TAVILY_API_KEY=
CHAT_HISTORY_LIMIT=15

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FROM_NAME='Sofia de Estrasol'

ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
ODOO_UID=
ODOO_TAG_ID=
ODOO_SELLER_ID=14
ODOO_SELLER_NAME='Ignacio Navarro'
